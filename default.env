PORT=3000 # Porta que irá rodar a API
SESSION_EXPIRATION_MINUTES=60 # Tempo em minutos que irá a autenticação
CORS_ORIGINS=http://localhost:5173 # URLs permitidas a consumir a API
DATABASE_URL="postgres://<USUARIO>:<SENHA>@localhost:5432/<NOME_DO_BANCO>" # Conexão do banco de dados
ENVIRONMENT="DEVELOP" # "DEVELOP" ou "PROD"
HOST=TRUE # TRUE ou FALSE - Se deve hospedar apenas no localhost ou para toda a rede